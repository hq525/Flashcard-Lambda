# Use isolated development AWS resources. Copy this file to .env and replace
# every placeholder. Never commit .env or AWS credentials.
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=flash-card-app-dev
S3_BUCKET=replace-with-private-development-bucket

# Cognito user-pool issuer, NOT its managed-login domain. Only verified ID
# tokens containing cognito:groups=["owner"] can access the API, including dev.
AUTH_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_REPLACE
AUTH_CLIENT_ID=replacewithpublicappclientid
# One exact frontend origin without trailing slash; loopback HTTP is allowed.
ALLOWED_ORIGIN=http://localhost:5173
